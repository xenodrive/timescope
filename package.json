{
  "private": true,
  "type": "module",
  "description": "Timescope - Canvas for Time-Series Visualization",
  "author": "Xenodrive, Inc.",
  "license": "MIT",
  "homepage": "https://xenodrive.github.io/timescope/",
  "repository": {
    "url": "https://github.com/xenodrive/timescope/"
  },
  "keywords": [
    "time-series",
    "timeseries",
    "timeline",
    "chart",
    "library",
    "typescript",
    "javascript"
  ],
  "scripts": {
    "dev": "pnpm run -C packages/timescope dev",
    "docs": "pnpm run -C packages/timescope-docs start",
    "clean": "pnpm run clean:libs",
    "clean:libs": "rm -rf dist",
    "clean:docs": "rm -rf packages/timescope-docs/dist",
    "build": "pnpm run build:libs; pnpm run build:docs",
    "build:libs": "pnpm run clean:libs; pnpm run -r --filter \\!timescope-docs --filter \\!. build && pnpm run check:libs",
    "build:docs": "pnpm run clean:docs; pnpm run -r --filter timescope-docs build",
    "check:libs": "vitest run tests/dist-*.test.ts"
  },
  "packageManager": "pnpm@12",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "rolldown-plugin-inline-worker": "0.0.1-alpha.1",
    "tsdown": "^0.23.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
