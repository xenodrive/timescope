{
  "private": true,
  "version": "0.0.0-alpha.11",
  "type": "module",
  "description": "Timescope - Canvas for Time-Series Visualization",
  "author": "Xenodrive, Inc.",
  "license": "MIT",
  "homepage": "https://xenodrive.github.io/timescope/",
  "repository": {
    "url": "https://github.com/xenodrive/timescope/"
  },
  "keywords": [
    "time-series",
    "timeseries",
    "timeline",
    "chart",
    "library",
    "typescript",
    "javascript"
  ],
  "scripts": {
    "dev": "pnpm run -C packages/timescope dev",
    "docs": "pnpm run -C packages/timescope-docs start",
    "build": "pnpm run build:libs; pnpm run build:docs",
    "build:libs": "pnpm run -r --filter \\!timescope-docs --filter \\!. build",
    "build:docs": "pnpm run -r --filter timescope-docs build"
  },
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.1.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rolldown-plugin-inline-worker": "0.0.1-alpha.1",
    "tsdown": "^0.20.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
