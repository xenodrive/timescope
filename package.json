{
  "private": true,
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Timescope - Canvas for Time-Series Visualization",
  "author": "Xenodrive, Inc.",
  "license": "MIT",
  "homepage": "https://xenodrive.github.io/timescope/",
  "repository": {
    "url": "https://github.com/xenodrive/timescope/"
  },
  "keywords": [
    "time-series",
    "timeseries",
    "timeline",
    "chart",
    "library",
    "typescript",
    "javascript"
  ],
  "scripts": {
    "dev": "pnpm run -C packages/timescope dev",
    "docs": "pnpm run -C packages/timescope-docs start",
    "build": "pnpm run build:libs && pnpm run check:libs; pnpm run build:docs",
    "build:libs": "pnpm run -r --filter \\!timescope-docs --filter \\!. build",
    "check:libs": "vitest run tests/dist-frameworks.test.ts",
    "build:docs": "pnpm run -r --filter timescope-docs build"
  },
  "packageManager": "pnpm@12",
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rolldown-plugin-inline-worker": "0.0.1-alpha.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
