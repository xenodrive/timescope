{
  "name": "@timescope/luna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Timescope component for Luna UI",
  "keywords": [
    "luna",
    "luna-ui"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "diagnose": "node ./diagnose.mjs",
    "dev": "vite",
    "build": "tsdown",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ./src",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "devDependencies": {
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "@luna_ui/luna": "^0.23.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "timescope": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "@luna_ui/luna": "^0.23.0",
    "timescope": "~0.1.0-alpha.0"
  }
}
