{
  "name": "@timescope/luna",
  "private": true,
  "type": "module",
  "description": "Timescope component for Luna UI",
  "keywords": [
    "luna",
    "luna-ui"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "diagnose": "node ./diagnose.mjs",
    "dev": "vite",
    "build": "tsdown",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.0",
    "@kikuchan/calendar": "^0.1.0-alpha.0",
    "@kikuchan/decimal": "^0.1.0-alpha.10",
    "@luna_ui/luna": "^0.23.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "@kikuchan/calendar": "^0.1.0-alpha.0",
    "@kikuchan/decimal": "^0.1.0-alpha.7",
    "@luna_ui/luna": "^0.23.0"
  },
  "dependencies": {
    "timescope": "workspace:*"
  }
}
