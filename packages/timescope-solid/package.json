{
  "name": "@timescope/solid",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Timescope component for SolidJS",
  "keywords": [
    "solid",
    "solidjs"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint ./src",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "solid-js": "^1.9.9",
    "timescope": "~0.1.0-alpha.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@vitest/browser-playwright": "^5.0.2",
    "bumpp": "^12.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-solid": "^0.18.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rolldown-plugin-solid": "^0.2.1",
    "timescope": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
