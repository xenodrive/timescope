{
  "name": "@timescope/solid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Timescope component for SolidJS",
  "keywords": [
    "solid",
    "solidjs"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "lint": "oxlint ./src",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "solid-js": "^1.9.9",
    "timescope": "~0.1.0-alpha.0"
  },
  "devDependencies": {
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@vitest/browser-playwright": "^5.0.3",
    "bumpp": "^12.3.0",
    "eslint-plugin-solid": "^0.18.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rolldown-plugin-solid": "^0.2.1",
    "solid-js": "^1.9.16",
    "timescope": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vite-plugin-solid": "^2.11.14"
  }
}
