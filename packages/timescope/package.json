{
  "name": "timescope",
  "private": true,
  "type": "module",
  "description": "Timescope - Canvas for Time-Series Visualization",
  "scripts": {
    "dev": "vite",
    "test": "tsc --noEmit && vitest run",
    "build": "tsdown",
    "watch": "tsdown -w",
    "lint": "eslint ./src",
    "format": "prettier --check .",
    "type:check": "tsc --noEmit"
  },
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "devDependencies": {
    "@kikuchan/calendar": "^0.0.1-alpha.2",
    "@kikuchan/decimal": "^0.1.0-alpha.7",
    "@napi-rs/canvas": "^0.1.88"
  },
  "peerDependencies": {
    "@kikuchan/calendar": "^0.0.1-alpha.2",
    "@kikuchan/decimal": "^0.1.0-alpha.7"
  }
}
