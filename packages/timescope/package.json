{
  "name": "timescope",
  "private": true,
  "type": "module",
  "description": "Timescope - Canvas for Time-Series Visualization",
  "scripts": {
    "dev": "vite",
    "test": "tsc --noEmit && vitest run",
    "build": "tsdown",
    "watch": "tsdown -w",
    "lint": "oxlint ./src",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "type:check": "tsc --noEmit"
  },
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.browser.ts",
      "node": "./src/index.node.ts",
      "default": "./src/index.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "devDependencies": {
    "@kikuchan/calendar": "^0.2.0-alpha.0",
    "@kikuchan/decimal": "^0.2.0-alpha.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "skia-canvas": "^3.0.8",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@kikuchan/calendar": "^0.2.0-alpha.0",
    "@kikuchan/decimal": "^0.2.0-alpha.0",
    "skia-canvas": "^3.0.8"
  },
  "peerDependenciesMeta": {
    "skia-canvas": {
      "optional": true
    }
  }
}
