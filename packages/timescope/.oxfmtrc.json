{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "arrowParens": "always",
  "sortImports": {
    "groups": ["import", "relative"],
    "customGroups": [{ "groupName": "relative", "elementNamePattern": ["./**", "../**"] }],
    "newlinesBetween": false,
    "sortSideEffects": false
  },
  "sortPackageJson": false,
  "ignorePatterns": ["node_modules", "dist", "src/mdi.ts", "src/mdi.json", "tests/artifacts", "*.json"]
}
