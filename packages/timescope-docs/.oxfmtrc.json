{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": ["node_modules", "dist", ".vitepress/cache", ".vitepress/dist", "src/public/**"]
}
