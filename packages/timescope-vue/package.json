    "eslint-plugin-vue": "^10.11.1",
    "oxfmt": "^0.72.0",
    "timescope": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
