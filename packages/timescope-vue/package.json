{
  "name": "@timescope/vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Timescope component for Vue",
  "keywords": [
    "vue"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
