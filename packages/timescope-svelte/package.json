{
  "name": "@timescope/svelte",
  "private": true,
  "type": "module",
  "description": "Timescope component for Svelte",
  "keywords": [
    "svelte"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "format": "prettier --check .",
    "lint": "prettier --check . && eslint ."
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/lib/index.ts",
  "main": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    }
  },
  "devDependencies": {
    "@kikuchan/calendar": "^0.0.1-alpha.4",
    "@kikuchan/decimal": "^0.1.0-alpha.10",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.24",
    "svelte": "^5.57.0",
    "svelte-preprocess": "^6.0.5"
  },
  "peerDependencies": {
    "@kikuchan/calendar": "^0.0.1-alpha.2",
    "@kikuchan/decimal": "^0.1.0-alpha.7",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "timescope": "workspace:*"
  }
}
