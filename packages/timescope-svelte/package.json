{
  "name": "@timescope/svelte",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Timescope component for Svelte",
  "keywords": [
    "svelte"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "format": "prettier --check .",
    "lint": "eslint ./src",
    "format:fix": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/lib/index.ts",
  "main": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.0",
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.24",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "timescope": "workspace:*"
  },
  "peerDependencies": {
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "svelte": "^5.0.0",
    "timescope": "~0.1.0-alpha.0"
  }
}
