{
  "name": "@timescope/svelte",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Timescope component for Svelte",
  "keywords": [
    "svelte"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "format": "oxfmt --check .",
    "lint": "eslint ./src",
    "format:fix": "oxfmt --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/lib/index.ts",
  "main": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts"
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "oxfmt": "^0.72.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "timescope": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "@kikuchan/calendar": "^0.2.0",
    "@kikuchan/decimal": "^0.2.0",
    "svelte": "^5.0.0",
    "timescope": "workspace:*"
  }
}
